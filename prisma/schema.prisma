generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Todo {
  id        String   @id @default(cuid())
  title     String
  url       String
  dominio   String
  timestamp DateTime @default(now())
  userAgent String
  referrer  String

}
